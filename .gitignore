# Python
__pycache__/
*.pyc
venv*/
.venv/
*.egg-info/
.ipynb_checkpoints/

# Experiment run outputs (keep results/reference/ tracked)
results/*
!results/.gitkeep
!results/reference/
results/reference/**/__pycache__/
output/
generatedExperiments/
debugLog.txt
*.log

# Heavy raw/testing workload variants (only the *_100_mostDiff subsets are shipped)
workloads/**/*_testing*/

# Heavy run artifacts archived outside git (shared cloud + Zenodo) — see ARTIFACTS.md
*run-outputs*.zip
logs/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Outputs of the revision analysis (regenerated by analysis_revision/, see its README)
analysis_revision/cache/
analysis_revision/out/
analysis_revision/figures/preview/

# Experiments of the revision (experiments/revision_r1/, see its README): raw outputs (already
# covered by output/ above), per-run cache, campaign logs and the single testbeds written by
# tools/gen_t1.sh, tools/gen_t3.sh and tools/make_singles.py
experiments/revision_r1/cache/
experiments/revision_r1/runlogs/
testbed/cl_*__*.json
testbed/bs_*__*.json
testbed/tm_*__*.json
testbed/mt_*__*.json
experiments/revision_r1/cache_mt/
